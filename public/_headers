# https://developers.cloudflare.com/workers/static-assets/headers
# https://opennext.js.org/cloudflare/caching#static-assets-caching
#
# Only /_next/static/* is safe to mark immutable: those filenames carry a content
# hash, so a changed file gets a new URL. Unhashed assets (/images/*, /fonts/*)
# are deliberately left on the default so a replaced file is not pinned in caches
# for a year.
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable
