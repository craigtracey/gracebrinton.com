# https://developers.cloudflare.com/workers/static-assets/headers
# https://opennext.js.org/cloudflare/caching#static-assets-caching
#
# Only /_next/static/* is safe to mark immutable: those filenames carry a content
# hash, so a changed file gets a new URL. Unhashed assets (/images/*, /fonts/*)
# are deliberately left on the default so a replaced file is not pinned in caches
# for a year.
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# Lead-magnet PDFs are linked from ActiveCampaign emails, not the site. Keep them
# out of search results so the email gate isn't bypassed by a Google hit.
/downloads/*
  X-Robots-Tag: noindex, nofollow

# Pre-resized images (scripts/optimize-images.mjs). Filenames aren't hashed, so
# cache for a day and revalidate in the background rather than marking immutable.
/_img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
