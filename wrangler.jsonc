{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gracebrinton-com",
  "main": ".open-next/worker.js",
  // NOTE: there is deliberately no `build.command` here.
  //
  // `opennextjs-cloudflare deploy` reads .open-next/.build/open-next.config.edge.mjs
  // and exits before it ever invokes wrangler, so a wrangler build command cannot
  // satisfy it — the build has to have run already. Worse, wrangler re-runs
  // build.command from inside that deploy, which wipes and rebuilds .open-next
  // underneath it (verified: a marker file in .open-next did not survive).
  //
  // So building is owned by the package.json scripts instead. Deploy with
  // `yarn cf:deploy`, preview with `yarn cf:preview`; both build first. A bare
  // `wrangler deploy` will not work from a clean checkout, by design.
  "compatibility_date": "2026-09-03",
  // nodejs_compat: the Next server bundle needs Node built-ins on workerd.
  // global_fetch_strictly_public: makes fetch() to our own hostname go back out
  // through the CDN rather than looping inside the Worker, which is what Next's
  // server-side fetches (e.g. the ActiveCampaign proxy in /api/subscribe) expect.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Powers next/image optimisation on Cloudflare (see next.config.ts
  // images.remotePatterns). Without this binding /_next/image 500s.
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
  // Deliberately absent: r2_buckets / d1_databases / WORKER_SELF_REFERENCE.
  // Those exist to support ISR revalidation, which this site does not use.
  // See the note in open-next.config.ts before adding them.
}
